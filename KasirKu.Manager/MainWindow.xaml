<Window x:Class="KasirKu.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasirKu Manager - Aplikasi Manajemen" Height="750" Width="1200"
        Icon="Assets/app.ico"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Sidebar button -->
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="6,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#16A34A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15803D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallRedButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallBlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,16,14,20">
                    <Image Source="/Assets/banyu_nobg.png" Width="180" Margin="0,0,0,6"/>
                    <TextBlock Text="MANAGER" Foreground="#64748B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTanggal" Text="..." Foreground="#94A3B8" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtJam" Text="..." Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtUserLogin" Text="Login: -" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <Button x:Name="BtnLogout" Style="{StaticResource SideButton}" Content="Keluar (Esc)" Foreground="#F87171" Click="BtnLogout_Click"/>
                    <Button x:Name="BtnRefreshData" Style="{StaticResource SideButton}" Content="F10 - Refresh Data" Click="BtnRefreshData_Click"/>
                    <TextBlock x:Name="TxtLastRefresh" Text="" Foreground="#475569" FontSize="10" Margin="8,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0,4,0,0">
                    <Button x:Name="BtnNavDashboard" Style="{StaticResource SideButton}" Content="F1 - Dashboard" Click="Nav_Click" Tag="Dashboard"/>
                    <Button x:Name="BtnNavProduk" Style="{StaticResource SideButton}" Content="F2 - Produk" Click="Nav_Click" Tag="Produk"/>
                    <Button x:Name="BtnNavStok" Style="{StaticResource SideButton}" Content="F3 - Stok" Click="Nav_Click" Tag="Stok"/>
                    <Button x:Name="BtnNavRiwayat" Style="{StaticResource SideButton}" Content="F4 - Riwayat" Click="Nav_Click" Tag="Riwayat"/>
                    <Button x:Name="BtnNavLaporan" Style="{StaticResource SideButton}" Content="F5 - Laporan" Click="Nav_Click" Tag="Laporan"/>
                    <Button x:Name="BtnNavPengaturan" Style="{StaticResource SideButton}" Content="F6 - Pengaturan" Click="Nav_Click" Tag="Pengaturan"/>
                    <Button x:Name="BtnNavMember" Style="{StaticResource SideButton}" Content="F7 - Member" Click="Nav_Click" Tag="Member"/>
                    <Button x:Name="BtnNavSupplier" Style="{StaticResource SideButton}" Content="F8 - Supplier" Click="Nav_Click" Tag="Supplier"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
                <StackPanel>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Dashboard" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtHeaderSub" Text="Ringkasan bisnis hari ini." FontSize="13" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- PAGE CONTAINER (tanpa ScrollViewer luar: agar DataGrid tetap bisa virtualisasi) -->
            <Border Grid.Row="1" Padding="24,16">
                <Grid>

                    <!-- ===== DASHBOARD (F1) ===== -->
                    <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Baris 1: Ringkasan Transaksi Hari Ini -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Background="#DBEAFE" BorderBrush="#BFDBFE">
                                <StackPanel>
                                    <TextBlock Text="Total Omzet" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                    <TextBlock x:Name="CardDashOmzet" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#1E3A8A"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,6,0" Background="#DCFCE7" BorderBrush="#BBF7D0">
                                <StackPanel>
                                    <TextBlock Text="💵 Tunai (Cash)" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                    <TextBlock x:Name="CardDashCash" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#14532D"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0,6,0" Background="#F3E8FF" BorderBrush="#DDD6FE">
                                <StackPanel>
                                    <TextBlock Text="📱 Non-Tunai" FontSize="11" FontWeight="SemiBold" Foreground="#6B21A8"/>
                                    <TextBlock x:Name="CardDashNonCash" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#581C87"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="3,0,6,0" Background="#FEF3C7" BorderBrush="#FDE68A">
                                <StackPanel>
                                    <TextBlock Text="Laba Estimasi" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                    <TextBlock x:Name="CardDashLaba" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#78350F"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="3,0,6,0" Background="#F0F9FF" BorderBrush="#BAE6FD">
                                <StackPanel>
                                    <TextBlock Text="Transaksi" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                                    <TextBlock x:Name="CardDashTrx" Text="0" FontSize="17" FontWeight="ExtraBold" Foreground="#0C4A6E"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource Card}" Margin="3,0,0,0" Background="#FFF1F2" BorderBrush="#FECDD3">
                                <StackPanel>
                                    <TextBlock Text="Item Terjual" FontSize="11" FontWeight="SemiBold" Foreground="#9F1239"/>
                                    <TextBlock x:Name="CardDashItem" Text="0" FontSize="17" FontWeight="ExtraBold" Foreground="#881337"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Baris 2: Total Entitas Master (Sesuai Referensi) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Background="#F8FAFC" BorderBrush="#E2E8F0">
                                <StackPanel>
                                    <TextBlock Text="📦 Total Produk Aktif" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBlock x:Name="CardDashTotalProduk" Text="0" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,6,0" Background="#F8FAFC" BorderBrush="#E2E8F0">
                                <StackPanel>
                                    <TextBlock Text="👥 Total Member Terdaftar" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBlock x:Name="CardDashTotalMember" Text="0" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0">
                                <StackPanel>
                                    <TextBlock Text="🏭 Total Supplier" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBlock x:Name="CardDashTotalSupplier" Text="0" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Baris 3: Stok Menipis & Transaksi Terbaru (Referensi Klien) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock Text="Stok Menipis (stok &lt;= 10)" FontWeight="Bold" FontSize="15" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="DgStokTipis" Height="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90"/>
                                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                                            <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="60"/>
                                            <DataGridTextColumn Header="Harga Jual" Binding="{Binding HargaJualRp}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                <DockPanel>
                                    <TextBlock Text="Transaksi Terbaru (Hari Ini)" FontWeight="Bold" FontSize="15" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="DgTrxTerbaru" Height="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110"/>
                                            <DataGridTextColumn Header="Waktu" Binding="{Binding TanggalStr}" Width="120"/>
                                            <DataGridTextColumn Header="Metode" Binding="{Binding MetodeBayar}" Width="80"/>
                                            <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Baris 4: Ringkasan Hari Ini -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ringkasan Performa Hari Ini" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtDashRingkasan" Text="-" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- ===== PRODUK (F2) ===== -->
                    <Grid x:Name="PageProduk" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar: Title & Tombol Tambah Produk -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Button x:Name="BtnBukaModalTambahProduk" DockPanel.Dock="Right" Content="+ Tambah Produk"
                                            Style="{StaticResource PrimaryButton}" Padding="16,8" Click="BtnBukaModalTambahProduk_Click"/>
                                    <TextBlock Text="Data Master Produk" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Filter Row: Pencarian & Dropdown Kelompok/Kategori -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtCariProduk" Margin="0,0,8,0"
                                             TextChanged="TxtCariProduk_TextChanged" ToolTip="Cari berdasarkan kode, barcode, nama, merek, supplier, atau kelompok..."/>
                                    <ComboBox Grid.Column="1" x:Name="CmbFilterKategoriProduk" SelectionChanged="CmbFilterKategoriProduk_SelectionChanged">
                                        <ComboBoxItem Content="Semua Kelompok" IsSelected="True"/>
                                        <ComboBoxItem Content="Makanan"/>
                                        <ComboBoxItem Content="Minuman"/>
                                        <ComboBoxItem Content="Snack"/>
                                        <ComboBoxItem Content="Frozen"/>
                                        <ComboBoxItem Content="ATK"/>
                                        <ComboBoxItem Content="Lainnya"/>
                                    </ComboBox>
                                </Grid>

                                <!-- DataGrid Produk Full Width -->
                                <DataGrid Grid.Row="2" x:Name="DgProduk" MouseDoubleClick="DgProduk_MouseDoubleClick"
                                          VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="85"/>
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="110"/>
                                        <DataGridTextColumn Header="Nama Barang" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="Merek" Binding="{Binding Merek}" Width="90"/>
                                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="60"/>
                                        <DataGridTextColumn Header="Harga Beli" Binding="{Binding HargaBeliRp}" Width="95"/>
                                        <DataGridTextColumn Header="Harga Jual" Binding="{Binding HargaJualRp}" Width="95"/>
                                        <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="55"/>
                                        <DataGridTextColumn Header="Margin" Binding="{Binding MarginStr}" Width="120"/>
                                        <DataGridTextColumn Header="Kelompok" Binding="{Binding Kelompok}" Width="85"/>
                                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="100"/>
                                        <DataGridTemplateColumn Header="Aksi" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Edit" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                                Style="{StaticResource SmallBlueButton}"
                                                                Click="BtnEditProdukGrid_Click" Tag="{Binding}"/>
                                                        <Button Content="Hapus" FontSize="11" Padding="8,3"
                                                                Style="{StaticResource SmallRedButton}"
                                                                Click="BtnHapusProduk_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== STOK (F3) ===== -->
                    <Grid x:Name="PageStok" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Log Barang Masuk / Keluar" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnHapusStokLog" Content="Hapus Semua" Style="{StaticResource DangerButton}" Margin="16,0,0,0" Padding="10,5" Click="BtnHapusStokLog_Click"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCariStok" Grid.Column="0" Margin="0,0,8,0" TextChanged="TxtCariStok_TextChanged"/>
                                    <ComboBox x:Name="CmbFilterJenis" Grid.Column="1" SelectionChanged="CmbFilterJenis_SelectionChanged">
                                        <ComboBoxItem Content="Semua" IsSelected="True"/>
                                        <ComboBoxItem Content="Masuk"/>
                                        <ComboBoxItem Content="Keluar"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Masuk Hari Ini" FontSize="12" Foreground="#166534"/>
                                            <TextBlock x:Name="CardStokMasuk" Text="+0" FontSize="20" FontWeight="ExtraBold" Foreground="#14532D"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Keluar Hari Ini" FontSize="12" Foreground="#991B1B"/>
                                            <TextBlock x:Name="CardStokKeluar" Text="-0" FontSize="20" FontWeight="ExtraBold" Foreground="#7F1D1D"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataGrid Grid.Row="3" x:Name="DgStok" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalStr}" Width="125"/>
                                        <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90"/>
                                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="70"/>
                                        <DataGridTextColumn Header="+/-" Binding="{Binding Perubahan}" Width="60"/>
                                        <DataGridTextColumn Header="Stok Akhir" Binding="{Binding StokSesudah}" Width="80"/>
                                        <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="170"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Barang Masuk / Keluar" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                                <TextBlock Text="Produk (Ketik Kode / Nama)" FontSize="12" Foreground="#64748B"/>
                                <Grid Margin="0,4,0,4">
                                    <TextBox x:Name="TxtInputStokProduk"
                                             Padding="10,8" FontSize="13"
                                             PreviewKeyDown="TxtInputStokProduk_PreviewKeyDown"
                                             TextChanged="TxtInputStokProduk_TextChanged"/>
                                    <!-- Popup Live Search Produk Stok -->
                                    <Popup x:Name="PupStokProduk" PlacementTarget="{Binding ElementName=TxtInputStokProduk}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           Width="{Binding ElementName=TxtInputStokProduk, Path=ActualWidth}">
                                        <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="8" Margin="0,4,0,0" SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                            </Border.Effect>
                                            <ListBox x:Name="LstCariStokProduk" MaxHeight="250" BorderThickness="0"
                                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     PreviewKeyDown="LstCariStokProduk_PreviewKeyDown"
                                                     MouseDoubleClick="LstCariStokProduk_Click"
                                                     PreviewMouseLeftButtonUp="LstCariStokProduk_Click">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,6"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Kode}" FontSize="11"
                                                                       Foreground="#2563EB" FontWeight="Bold"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="65"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Nama}" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#0F172A"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding StokStr}" FontSize="11"
                                                                       Foreground="#64748B" FontWeight="Bold"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock x:Name="TxtStokSaatIni" Text="Stok saat ini: -" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <TextBlock Text="Jenis" FontSize="12" Foreground="#64748B"/>
                                <ComboBox x:Name="CmbJenisStok" Margin="0,4,0,10">
                                    <ComboBoxItem Content="Masuk" IsSelected="True"/>
                                    <ComboBoxItem Content="Keluar"/>
                                </ComboBox>
                                <TextBlock Text="Jumlah (Qty)" FontSize="12" Foreground="#64748B"/>
                                <TextBox x:Name="TxtStokQty" Margin="0,4,0,10"/>
                                <TextBlock Text="Keterangan" FontSize="12" Foreground="#64748B"/>
                                <ComboBox x:Name="CmbStokKet" Margin="0,4,0,14" IsEditable="True" Text="Restok supplier">
                                    <ComboBoxItem Content="Restok supplier"/>
                                    <ComboBoxItem Content="Retur supplier"/>
                                    <ComboBoxItem Content="Barang rusak"/>
                                    <ComboBoxItem Content="Barang hilang"/>
                                    <ComboBoxItem Content="Koreksi stok"/>
                                    <ComboBoxItem Content="Penyesuaian manual"/>
                                </ComboBox>
                                <Button Content="Simpan" Style="{StaticResource PrimaryButton}" Click="BtnSimpanStok_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== RIWAYAT (F4) ===== -->
                    <Grid x:Name="PageRiwayat" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Metode:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbFilterMetodeRiwayat" Width="140" SelectionChanged="CmbFilterMetodeRiwayat_SelectionChanged">
                                            <ComboBoxItem Content="Semua Metode" IsSelected="True"/>
                                            <ComboBoxItem Content="💵 Hanya Tunai"/>
                                            <ComboBoxItem Content="📱 Hanya Non-Tunai"/>
                                        </ComboBox>
                                        <Button Content="Hapus Semua" Style="{StaticResource DangerButton}" Margin="12,0,0,0" Padding="10,5" Click="BtnHapusRiwayat_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="Riwayat Transaksi" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Grid.Row="1" x:Name="TxtCariRiwayat" Margin="0,0,0,10" TextChanged="TxtCariRiwayat_TextChanged"/>
                                <DataGrid Grid.Row="2" x:Name="DgRiwayat" SelectionChanged="DgRiwayat_SelectionChanged" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalStr}" Width="130"/>
                                        <DataGridTextColumn Header="Metode" Binding="{Binding MetodeBayar}" Width="85"/>
                                        <DataGridTextColumn Header="Item" Binding="{Binding JumlahItem}" Width="45"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="*"/>
                                        <DataGridTemplateColumn Header="Aksi" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Edit" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                                                Style="{StaticResource SmallBlueButton}"
                                                                Click="BtnEditSatuTrxGrid_Click" Tag="{Binding}"/>
                                                        <Button Content="Hapus" FontSize="11" Padding="6,2"
                                                                Style="{StaticResource SmallRedButton}"
                                                                Click="BtnHapusSatuTrxGrid_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="TxtDetailJudul" Text="Detail Transaksi" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" x:Name="DgRiwayatDetail">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="45"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalRp}" Width="105"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="2" x:Name="TxtDetailTotal" Text="" FontWeight="Bold" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnEditRiwayat" Grid.Column="0" Content="✏️ Edit Transaksi" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="BtnEditTransaksi_Click" ToolTip="Edit detail transaksi ini"/>
                                        <Button x:Name="BtnHapusSatuRiwayat" Grid.Column="1" Content="🗑️ Hapus Transaksi" Style="{StaticResource DangerButton}" Margin="4,0,0,0" Click="BtnHapusSatuTransaksi_Click" ToolTip="Hapus transaksi ini dan kembalikan stok"/>
                                    </Grid>
                                    <Button Content="F7 - Cetak Struk (PDF / Thermal)" Style="{StaticResource PrimaryButton}" Click="BtnCetakStruk_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== LAPORAN (F5) ===== -->
                    <ScrollViewer x:Name="PageLaporan" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Periode:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpDari" Width="150" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpSampai" Width="150" Margin="0,0,8,0"/>
                                <Button Content="Terapkan" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="BtnTerapkanFilter_Click" Margin="0,0,8,0"/>
                                <Button Content="Hari Ini" Style="{StaticResource GhostButton}" Padding="16,6" Click="BtnHariIni_Click" Margin="0,0,8,0"/>
                                <Button Content="F8 - Export PDF" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="BtnExportPdf_Click" Margin="0,0,8,0"/>
                                <Button Content="F9 - Export Excel (CSV)" Style="{StaticResource SuccessButton}" Padding="16,6" Click="BtnExportExcel_Click"/>
                            </WrapPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,12" Background="#DBEAFE" BorderBrush="#BFDBFE">
                                <StackPanel>
                                    <TextBlock Text="Total Omzet" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                    <TextBlock x:Name="CardOmzet" Text="Rp 0" FontSize="15" FontWeight="ExtraBold" Foreground="#1E3A8A"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="2,0,4,12" Background="#DCFCE7" BorderBrush="#BBF7D0">
                                <StackPanel>
                                    <TextBlock Text="💵 Tunai (Cash)" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                    <TextBlock x:Name="CardOmzetCash" Text="Rp 0" FontSize="15" FontWeight="ExtraBold" Foreground="#14532D"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="2,0,4,12" Background="#F3E8FF" BorderBrush="#DDD6FE">
                                <StackPanel>
                                    <TextBlock Text="📱 Non-Tunai" FontSize="11" FontWeight="SemiBold" Foreground="#6B21A8"/>
                                    <TextBlock x:Name="CardOmzetNonCash" Text="Rp 0" FontSize="15" FontWeight="ExtraBold" Foreground="#581C87"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="2,0,4,12" Background="#FEF3C7" BorderBrush="#FDE68A">
                                <StackPanel>
                                    <TextBlock Text="💸 Uang Keluar" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                    <TextBlock x:Name="CardOmzetKeluar" Text="Rp 0" FontSize="15" FontWeight="ExtraBold" Foreground="#78350F"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="2,0,4,12" Background="#ECFDF5" BorderBrush="#A7F3D0">
                                <StackPanel>
                                    <TextBlock Text="Laba Estimasi" FontSize="11" FontWeight="SemiBold" Foreground="#065F46"/>
                                    <TextBlock x:Name="CardLaba" Text="Rp 0" FontSize="15" FontWeight="ExtraBold" Foreground="#064E3B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource Card}" Margin="2,0,4,12" Background="#F0F9FF" BorderBrush="#BAE6FD">
                                <StackPanel>
                                    <TextBlock Text="Transaksi" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                                    <TextBlock x:Name="CardTransaksi" Text="0" FontSize="15" FontWeight="ExtraBold" Foreground="#0C4A6E"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource Card}" Margin="2,0,4,12" Background="#F8FAFC" BorderBrush="#E2E8F0">
                                <StackPanel>
                                    <TextBlock Text="Item Terjual" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBlock x:Name="CardItem" Text="0" FontSize="15" FontWeight="ExtraBold" Foreground="#1E293B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource Card}" Margin="2,0,0,12" Background="#FFF1F2" BorderBrush="#FECDD3">
                                <StackPanel>
                                    <TextBlock Text="Rata/Nota" FontSize="11" FontWeight="SemiBold" Foreground="#9F1239"/>
                                    <TextBlock x:Name="CardRata" Text="Rp 0" FontSize="15" FontWeight="ExtraBold" Foreground="#881337"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock Text="Produk Terlaris" FontWeight="Bold" FontSize="15" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="DgLaris" Height="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Produk" Binding="{Binding Nama}" Width="*"/>
                                            <DataGridTextColumn Header="Terjual" Binding="{Binding Terjual}" Width="65"/>
                                            <DataGridTextColumn Header="Omzet" Binding="{Binding OmzetRp}" Width="110"/>
                                            <DataGridTextColumn Header="Laba" Binding="{Binding LabaRp}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Ringkasan Performa" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtRingkasan" Text="-" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtExportInfo" Text="File tersimpan di Documents/KasirKu/Laporan/" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock Text="Pengeluaran Kas (Uang Keluar Drawer)" FontWeight="Bold" FontSize="14" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                                        <DataGrid x:Name="DgPengeluaranLaporan" Height="150" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Waktu" Binding="{Binding TanggalStr}" Width="110"/>
                                                <DataGridTextColumn Header="Kasir" Binding="{Binding KasirNama}" Width="75"/>
                                                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="85"/>
                                                <DataGridTextColumn Header="Keperluan" Binding="{Binding Keterangan}" Width="*"/>
                                                <DataGridTextColumn Header="Nominal" Binding="{Binding NominalRp}" Width="95"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- ===== PENGATURAN (F6) ===== -->
                    <Grid x:Name="PagePengaturan" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Profil Toko & Printer Thermal -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Pengaturan Toko &amp; Kasir" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>
                                <TextBlock Text="Nama Toko (tampil di struk &amp; laporan)" FontSize="12" Foreground="#64748B"/>
                                <TextBox x:Name="TxtNamaToko" Margin="0,3,0,8"/>
                                <TextBlock Text="Alamat" FontSize="12" Foreground="#64748B"/>
                                <TextBox x:Name="TxtAlamatToko" Margin="0,3,0,8"/>
                                <TextBlock Text="Kota" FontSize="12" Foreground="#64748B"/>
                                <TextBox x:Name="TxtKotaToko" Margin="0,3,0,8"/>
                                <TextBlock Text="Telepon" FontSize="12" Foreground="#64748B"/>
                                <TextBox x:Name="TxtTelpToko" Margin="0,3,0,8"/>
                                <TextBlock Text="Footer Struk" FontSize="12" Foreground="#64748B"/>
                                <TextBox x:Name="TxtFooterStruk" Margin="0,3,0,8" AcceptsReturn="True" Height="46"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         ToolTip="Boleh lebih dari satu baris. Contoh: TERIMA KASIH (baris baru) ATAS KUNJUNGANNYA"/>

                                <Border Height="1" Background="#E2E8F0" Margin="0,4,0,12"/>

                                <TextBlock Text="Logo pada Struk" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Border Background="White" CornerRadius="6" Padding="6" Height="66">
                                            <Image x:Name="ImgLogoPreview" Stretch="Uniform" Height="52"/>
                                        </Border>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtLogoPath" IsReadOnly="True" FontSize="11" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Pilih..." Style="{StaticResource GhostButton}" Padding="8,6" Margin="6,0,0,0" Click="BtnPilihLogo_Click"/>
                                            <Button Grid.Column="2" Content="Default" Style="{StaticResource GhostButton}" Padding="8,6" Margin="6,0,0,0" Click="BtnResetLogo_Click" ToolTip="Kembalikan ke logo bawaan BANYU FROZEN FOOD"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="ChkTampilkanLogo" Content="Cetak logo di kepala struk" Margin="0,0,0,12" FontSize="12" IsChecked="True"/>

                                <Border Height="1" Background="#E2E8F0" Margin="0,4,0,12"/>

                                <TextBlock Text="Printer Thermal (Struk &amp; Kasir)" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                                <TextBlock Text="Nama Printer Windows" FontSize="12" Foreground="#64748B"/>
                                <Grid Margin="0,3,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbPrinterName" IsEditable="True"/>
                                    <Button Grid.Column="1" Content="Cek" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="8,6" Click="BtnRefreshPrinter_Click" ToolTip="Muat ulang daftar printer Windows"/>
                                </Grid>

                                <TextBlock Text="Lebar Kertas / Tipe Printer" FontSize="12" Foreground="#64748B"/>
                                <ComboBox x:Name="CmbLebarKertas" Margin="0,3,0,8">
                                    <ComboBoxItem Content="80 mm (Standar Thermal 48 Kolom)" IsSelected="True"/>
                                    <ComboBoxItem Content="76 mm (Dot Matrix / Epson TM-U220 40 Kolom)"/>
                                    <ComboBoxItem Content="58 mm (Mini Thermal 32 Kolom)"/>
                                </ComboBox>

                                <CheckBox x:Name="ChkAutoCetakStruk" Content="Cetak struk otomatis setelah bayar" Margin="0,4,0,4" FontSize="12" IsChecked="True"/>
                                <CheckBox x:Name="ChkKickDrawer" Content="Buka laci kasir (Cash Drawer) otomatis" Margin="0,4,0,4" FontSize="12" IsChecked="True"/>
                                <CheckBox x:Name="ChkCetakSatuanStruk" Content="Tampilkan satuan produk di struk (mis: pcs, kg, pack)" Margin="0,4,0,12" FontSize="12" IsChecked="True"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Test Print" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="BtnTestPrint_Click"/>
                                    <Button Grid.Column="1" Content="Pratinjau Struk" Style="{StaticResource GhostButton}" Margin="2,0,2,0" Click="BtnCetakContohStruk_Click" ToolTip="Lihat tampilan struk di layar (tanpa mencetak kertas)"/>
                                    <Button Grid.Column="2" Content="Buka Laci" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="BtnBukaLaci_Click"/>
                                </Grid>

                                <Button Content="Simpan Pengaturan" Style="{StaticResource SuccessButton}" Click="BtnSimpanPengaturan_Click" Margin="0,4,0,0"/>
                                <TextBlock Text="Pengaturan ini dipakai bersama oleh aplikasi POS dan Manager." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Manajemen Pengguna (CRUD) -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <DockPanel>
                                <TextBlock Text="Manajemen Akun / Pengguna" FontWeight="Bold" FontSize="15" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                                <TextBlock Text="Kelola akun kasir dan manajer yang dapat login." FontSize="12" Foreground="#64748B" DockPanel.Dock="Top" Margin="0,0,0,12"/>

                                <!-- Form Tambah User -->
                                <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Tambah Akun Baru" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Username" FontSize="11" Foreground="#64748B"/>
                                                <TextBox x:Name="TxtNewUsername" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Nama Lengkap" FontSize="11" Foreground="#64748B"/>
                                                <TextBox x:Name="TxtNewNamaLengkap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Role" FontSize="11" Foreground="#64748B"/>
                                                <ComboBox x:Name="CmbNewRole" Margin="0,2,0,0">
                                                    <ComboBoxItem Content="Kasir" IsSelected="True"/>
                                                    <ComboBoxItem Content="Manager"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Password" FontSize="11" Foreground="#64748B"/>
                                                <PasswordBox x:Name="TxtNewPassword" Margin="0,2,0,0" Padding="10,8" FontSize="13" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="+ Tambah Pengguna" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BtnTambahUser_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Tabel User -->
                                <DataGrid x:Name="DgUsers" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" Height="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="100"/>
                                        <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding NamaLengkap}" Width="*"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="85"/>
                                        <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Aktif}" Width="55"/>
                                        <DataGridTemplateColumn Header="Aksi" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Status" FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                                                Style="{StaticResource GhostButton}"
                                                                Click="BtnToggleAktifUser_Click" Tag="{Binding}"/>
                                                        <Button Content="Hapus" FontSize="11" Padding="6,3"
                                                                Style="{StaticResource SmallRedButton}"
                                                                Click="BtnHapusUser_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
