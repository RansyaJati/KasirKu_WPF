                        <Button Grid.Column="1" Content="Simpan Member" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnSimpanModalMember_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL SUPPLIER (TAMBAH / EDIT) -->
        <Grid x:Name="ModalSupplier" Visibility="Collapsed" Grid.ColumnSpan="2" Panel.ZIndex="1000" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="500" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalSupplier_Click"/>
                        <TextBlock x:Name="TxtModalSupplierJudul" Text="Tambah Supplier Baru" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="Nama Pemasok / Perusahaan *" FontSize="12" Foreground="#64748B"/>
                        <TextBox x:Name="TxtModalSupplierNama" Margin="0,4,0,10"/>

                        <TextBlock Text="No. Handphone / Telepon *" FontSize="12" Foreground="#64748B"/>
                        <TextBox x:Name="TxtModalSupplierNoHp" Margin="0,4,0,10"/>

                        <TextBlock Text="Alamat" FontSize="12" Foreground="#64748B"/>
                        <TextBox x:Name="TxtModalSupplierAlamat" Margin="0,4,0,10" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Email" FontSize="12" Foreground="#64748B"/>
                        <TextBox x:Name="TxtModalSupplierEmail" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnTutupModalSupplier_Click"/>
                        <Button Grid.Column="1" Content="Simpan Supplier" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnSimpanModalSupplier_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
