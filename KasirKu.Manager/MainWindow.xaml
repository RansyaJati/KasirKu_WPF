                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar: Title & Tombol Tambah Member -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Button x:Name="BtnBukaModalTambahMember" DockPanel.Dock="Right" Content="+ Tambah Member"
                                            Style="{StaticResource PrimaryButton}" Padding="16,8" Click="BtnBukaModalTambahMember_Click"/>
                                    <TextBlock Text="Data Pelanggan / Member Toko" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Filter Row: Pencarian -->
                                <TextBox Grid.Row="1" x:Name="TxtCariMember" Margin="0,0,0,10"
