                                <!-- DataGrid Member -->
                                <DataGrid Grid.Row="2" x:Name="DgMember" MouseDoubleClick="DgMember_MouseDoubleClick"
                                          VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                        <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="No. Handphone" Binding="{Binding NoHp}" Width="140"/>
                                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="200"/>
                                        <DataGridTextColumn Header="Poin" Binding="{Binding PoinStr}" Width="90"/>
                                        <DataGridTextColumn Header="Tgl Daftar" Binding="{Binding TanggalDaftarStr}" Width="100"/>
                                        <DataGridTemplateColumn Header="Aksi" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Edit" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                                Style="{StaticResource SmallBlueButton}"
                                                                Click="BtnEditMemberGrid_Click" Tag="{Binding}"/>
                                                        <Button Content="Hapus" FontSize="11" Padding="8,3"
                                                                Style="{StaticResource SmallRedButton}"
                                                                Click="BtnHapusMember_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== SUPPLIER (F8) ===== -->
                    <Grid x:Name="PageSupplier" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar: Title & Tombol Tambah Supplier -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Button x:Name="BtnBukaModalTambahSupplier" DockPanel.Dock="Right" Content="+ Tambah Supplier"
                                            Style="{StaticResource PrimaryButton}" Padding="16,8" Click="BtnBukaModalTambahSupplier_Click"/>
                                    <TextBlock Text="Data Pemasok / Supplier" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Filter Row: Pencarian -->
                                <TextBox Grid.Row="1" x:Name="TxtCariSupplier" Margin="0,0,0,10"
                                         TextChanged="TxtCariSupplier_TextChanged" ToolTip="Cari berdasarkan nama, nomor HP, email, atau alamat supplier..."/>

                                <!-- DataGrid Supplier -->
                                <DataGrid Grid.Row="2" x:Name="DgSupplier" MouseDoubleClick="DgSupplier_MouseDoubleClick"
                                          VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                        <DataGridTextColumn Header="Nama Pemasok" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="No. Handphone" Binding="{Binding NoHp}" Width="140"/>
                                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="200"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                                        <DataGridTemplateColumn Header="Aksi" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Edit" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                                Style="{StaticResource SmallBlueButton}"
                                                                Click="BtnEditSupplierGrid_Click" Tag="{Binding}"/>
                                                        <Button Content="Hapus" FontSize="11" Padding="8,3"
                                                                Style="{StaticResource SmallRedButton}"
                                                                Click="BtnHapusSupplier_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- MODAL EDIT TRANSAKSI -->
        <Grid x:Name="ModalEditTransaksi" Visibility="Collapsed" Grid.ColumnSpan="2" Panel.ZIndex="1000" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="680" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalEditTrx_Click"/>
                        <TextBlock x:Name="TxtModalEditTrxJudul" Text="✏️ Edit Transaksi" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Info Transaksi -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tanggal" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                            <DatePicker x:Name="DpEditTrxTanggal"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Jam (HH:mm)" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEditTrxJam" Text="12:00" Padding="8,6" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Metode Pembayaran" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbEditTrxMetode">
                                <ComboBoxItem Content="Tunai"/>
                                <ComboBoxItem Content="QRIS"/>
                                <ComboBoxItem Content="GoPay"/>
                                <ComboBoxItem Content="OVO"/>
                                <ComboBoxItem Content="DANA"/>
                                <ComboBoxItem Content="ShopeePay"/>
                                <ComboBoxItem Content="Transfer Bank"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Nama Kasir" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEditTrxKasir" Padding="8,6" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Item DataGrid -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,12">
                        <DataGrid x:Name="DgEditTrxItems" MaxHeight="220" AutoGenerateColumns="False" CanUserAddRows="False" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nama Barang" Binding="{Binding Nama}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="55" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Harga (Rp)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Harga, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}"
                                                     Padding="6,4" FontSize="12" TextAlignment="Right"
                                                     TextChanged="TxtEditTrxHarga_TextChanged"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qty" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="-" Width="22" Height="22" Click="BtnEditTrxQtyMin_Click" Tag="{Binding}" Style="{StaticResource SmallBlueButton}"/>
                                                <TextBlock Text="{Binding Qty}" Width="32" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="+" Width="22" Height="22" Click="BtnEditTrxQtyPlus_Click" Tag="{Binding}" Style="{StaticResource SmallBlueButton}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalRp}" Width="105" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Width="26" Height="22" Click="BtnEditTrxHapusItem_Click" Tag="{Binding}" Style="{StaticResource SmallRedButton}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Summary (Total, Bayar, Kembalian) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Belanja" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtEditTrxTotal" Text="Rp 0" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="Nominal Bayar" FontSize="11" Foreground="#64748B"/>
                                <TextBox x:Name="TxtEditTrxBayar" FontSize="14" FontWeight="Bold" Padding="8,4"
                                         TextChanged="TxtEditTrxBayar_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kembalian" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtEditTrxKembali" Text="Rp 0" FontSize="16" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnTutupModalEditTrx_Click"/>
                        <Button Grid.Column="1" Content="Simpan Perubahan Transaksi" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnSimpanEditTrx_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL PRODUK (TAMBAH / EDIT) -->
        <Grid x:Name="ModalProduk" Visibility="Collapsed" Grid.ColumnSpan="2" Panel.ZIndex="1000" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="640" MaxHeight="680" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalProduk_Click"/>
                        <TextBlock x:Name="TxtModalProdukJudul" Text="Tambah Produk Baru" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Form Isi -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Kode Produk *" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtModalKode" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Kode Barcode" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtModalBarcode" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Nama Produk *" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtModalNama" Margin="0,4,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Merek / Brand" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtModalMerek" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Satuan" FontSize="12" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbModalSatuan" Margin="0,4,0,0" IsEditable="True" Text="Pcs">
                                        <ComboBoxItem Content="Pcs" IsSelected="True"/>
                                        <ComboBoxItem Content="Pack"/>
                                        <ComboBoxItem Content="Dus"/>
                                        <ComboBoxItem Content="Karton"/>
                                        <ComboBoxItem Content="Kg"/>
                                        <ComboBoxItem Content="Gram"/>
                                        <ComboBoxItem Content="Liter"/>
                                        <ComboBoxItem Content="Botol"/>
                                        <ComboBoxItem Content="Lusin"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Harga Beli (Rp)" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtModalHargaBeli" Margin="0,4,0,0" TextChanged="TxtModalHargaMargin_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Harga Jual (Rp) *" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtModalHargaJual" Margin="0,4,0,0" TextChanged="TxtModalHargaMargin_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Stok Awal/Qty" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtModalStok" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtModalMarginInfo" Text="Margin: -" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Kelompok / Kategori" FontSize="12" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbModalKategori" Margin="0,4,0,0">
                                        <ComboBoxItem Content="Makanan" IsSelected="True"/>
                                        <ComboBoxItem Content="Minuman"/>
                                        <ComboBoxItem Content="Snack"/>
                                        <ComboBoxItem Content="Frozen"/>
                                        <ComboBoxItem Content="ATK"/>
                                        <ComboBoxItem Content="Lainnya"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Supplier / Pemasok" FontSize="12" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbModalSupplier" Margin="0,4,0,0" IsEditable="True"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnTutupModalProduk_Click"/>
                        <Button Grid.Column="1" Content="Simpan Produk" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnSimpanModalProduk_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL MEMBER (TAMBAH / EDIT) -->
        <Grid x:Name="ModalMember" Visibility="Collapsed" Grid.ColumnSpan="2" Panel.ZIndex="1000" Background="#88000000">
