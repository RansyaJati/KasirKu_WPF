<Window x:Class="KasirKu.POS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasirKu POS - Login" Height="600" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#0F172A" CornerRadius="18"
            BorderBrush="#1E293B" BorderThickness="1"
            Effect="{x:Null}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- DRAG BAR + CLOSE -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
                <DockPanel Margin="18,12,12,0">
                    <Button DockPanel.Dock="Right" Content="X" Width="32" Height="32"
                            Background="#DC2626" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock/>
                </DockPanel>
            </Border>

            <!-- LOGIN FORM -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0,48,30">

                <!-- Logo -->
                <Image Source="/Assets/banyu_nobg.png" Width="220" Margin="0,0,0,4"/>
                <TextBlock Text="KASIR POS" Foreground="#64748B" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <Border Background="#1E293B" CornerRadius="8" Padding="10,6" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock Text="Masuk ke akun Kasir Anda" Foreground="#94A3B8" FontSize="12"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Username" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" FontSize="14" Padding="12,10"
                         Background="#1E293B" Foreground="White" CaretBrush="White"
                         BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16"
                         KeyDown="TxtUsername_KeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Password -->
                <TextBlock Text="Password" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" FontSize="14" Padding="12,10"
                             Background="#1E293B" Foreground="White" CaretBrush="White"
                             BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8"
                             KeyDown="TxtPassword_KeyDown">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Error message -->
                <TextBlock x:Name="TxtError" Text="" Foreground="#F87171" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"/>

                <!-- Login button -->
                <Button x:Name="BtnLogin" Content="Masuk" FontSize="14" FontWeight="Bold"
                        Padding="14,12" Cursor="Hand" Click="BtnLogin_Click" IsDefault="True"
                        Background="#2563EB" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Info -->
                <TextBlock Text="Tekan Enter untuk masuk" Foreground="#475569" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Default: kasir / kasir123" Foreground="#334155" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
