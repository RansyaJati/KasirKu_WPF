<Window x:Class="KasirKu.POS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasirKu POS - Kasir Fullscreen" Height="800" Width="1280"
        Icon="Assets/app.ico"
        MinHeight="650" MinWidth="1000"
        WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerFButton" TargetType="Button" BasedOn="{StaticResource FButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallGridButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBlueButton" TargetType="Button" BasedOn="{StaticResource SmallGridButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallRedButton" TargetType="Button" BasedOn="{StaticResource SmallGridButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#16A34A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15803D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#0F172A" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/banyu_nobg.png" Width="252" Height="62" Margin="0,0,10,0"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtTanggal" Text="..." Foreground="#E2E8F0" FontSize="12" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtJam" Text="..." Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnF1Kasir" Style="{StaticResource FButton}" Content="F1 - Kasir" Click="FNav_Click" Tag="Kasir"/>
                    <Button x:Name="BtnF2Cek" Style="{StaticResource FButton}" Content="F2 - Cek Barang" Click="FNav_Click" Tag="Cek"/>
                    <Button x:Name="BtnF3Riwayat" Style="{StaticResource FButton}" Content="F3 - Riwayat" Click="FNav_Click" Tag="Riwayat"/>
                    <Button x:Name="BtnF4Rekap" Style="{StaticResource FButton}" Content="F4 - Rekap Shift" Click="FNav_Click" Tag="Rekap"/>
                    <Border Width="1" Background="#334155" Margin="8,4"/>
                    <Button x:Name="BtnF5Bayar" Style="{StaticResource FButton}" Content="F5 - Bayar" Click="BtnBayar_Click"/>
                    <Button x:Name="BtnF6Reset" Style="{StaticResource FButton}" Content="F6 - Reset" Click="BtnResetKeranjang_Click"/>
                    <Border Width="1" Background="#334155" Margin="8,4"/>
                    <Button x:Name="BtnF7Struk" Style="{StaticResource FButton}" Content="F7 - Pratinjau Struk" Click="BtnCetakStruk_Click"/>
                    <Button x:Name="BtnF8Printer" Style="{StaticResource FButton}" Content="F8 - Printer" Click="BtnF8Printer_Click"/>
                    <Button x:Name="BtnF9CustomHarga" Style="{StaticResource FButton}" Content="F9 - Ubah Harga" Click="BtnF9CustomHarga_Click" Background="#4338CA" BorderBrush="#6366F1"/>
                    <Border Width="1" Background="#334155" Margin="8,4"/>
                    <Button x:Name="BtnKasKeluar" Style="{StaticResource FButton}" Content="💸 Ambil Uang/Kas Keluar" Click="BtnKasKeluar_Click" Background="#B45309" BorderBrush="#D97706" ToolTip="Catat pengeluaran uang laci (setoran/beli kebutuhan) &amp; cetak bukti"/>
                    <Button x:Name="BtnBukaLaciTop" Style="{StaticResource FButton}" Content="Buka Laci" Click="BtnBukaLaciKasir_Click"/>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtUserInfo" Text="KASIR POS" Foreground="#64748B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="Scan barcode + Enter" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button x:Name="BtnKeluar" Style="{StaticResource DangerFButton}" Content="Keluar (Esc)" Padding="14,8" Click="BtnKeluar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUB HEADER -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="Kasir" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A"/>
                <TextBlock x:Name="TxtHeaderSub" Text="Scan barcode / ketik kode atau nama + Enter." FontSize="13" Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="2" Margin="18,0,18,14">

            <!-- ===== PAGE KASIR (F1) ===== -->
            <Grid x:Name="PageKasir">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnHoldCart" Content="⏸️ Tahan Antrean (Hold)" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0" FontSize="12" Click="BtnHoldCart_Click" ToolTip="Tahan keranjang customer ini sementara agar bisa melayani customer lain"/>
                                <Button x:Name="BtnRecallCart" Content="📋 Buka Antrean Tertahan (0)" Background="#4338CA" Foreground="White" BorderThickness="0" Padding="10,4" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="BtnRecallCart_Click" ToolTip="Muat kembali antrean yang ditahan"/>
                            </StackPanel>
                            <TextBlock Text="Daftar Belanja" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtInfoKeranjang" Text="0 item" Foreground="#64748B" FontSize="12" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <DataGrid x:Name="DgKeranjang" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Barang" Binding="{Binding NamaDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Harga" Binding="{Binding HargaRp}" Width="105"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="50"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalRp}" Width="125"/>
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="+" Width="28" Height="24" Margin="0,0,4,0" Style="{StaticResource SmallBlueButton}" Click="BtnQtyPlus_Click" Tag="{Binding}"/>
                                                <Button Content="-" Width="28" Height="24" Style="{StaticResource SmallBlueButton}" Click="BtnQtyMin_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Width="30" Height="24"
                                                    Style="{StaticResource SmallRedButton}"
                                                    Click="BtnHapusItem_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock Text="Scan / Pembayaran (F5=Bayar, F6=Reset)" FontWeight="Bold" FontSize="15" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <Border DockPanel.Dock="Top" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Banner Indikator Mode Custom Harga Aktif (F9) -->
                                <Border x:Name="PnlCustomHargaAktif" Visibility="Collapsed"
                                        Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.5"
                                        CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button Content="Batal (Esc)" DockPanel.Dock="Right" Padding="8,3"
                                                FontSize="11" FontWeight="Bold" Background="#DC2626" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" Click="BtnBatalCustomHarga_Click"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏷️ HARGA KHUSUS:" FontWeight="Bold" FontSize="12" Foreground="#92400E" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtCustomHargaLabel" Text="Rp 8.000" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="0,0,8,0"/>
                                            <TextBlock Text="(Untuk 1 item berikutnya)" FontSize="11" Foreground="#78350F" FontStyle="Italic"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                    <Grid>
                        <TextBox x:Name="TxtScan" FontSize="16" FontWeight="Bold" Padding="10,8"
                                 CaretBrush="#1D4ED8"
                                 PreviewKeyDown="TxtScan_PreviewKeyDown" TextChanged="TxtScan_TextChanged"/>
                        <!-- Popup autocomplete produk (kode/barcode/nama) -->
                        <Popup x:Name="PupProduk" PlacementTarget="{Binding ElementName=TxtScan}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Width="{Binding ElementName=TxtScan, Path=ActualWidth}">
                            <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <ListBox x:Name="LstCariProduk" MaxHeight="300" BorderThickness="0"
                                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="LstCariProduk_PreviewKeyDown"
                                         MouseDoubleClick="LstCariProduk_Click"
                                         PreviewMouseLeftButtonUp="LstCariProduk_Click">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,7"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Kode}" FontSize="12"
                                                           Foreground="#2563EB" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="70"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nama}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Barcode}" FontSize="10.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding HargaRp}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding StokStr}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                                <TextBlock Text="Scan barcode / ketik kode atau nama + Enter. Cepat: 3*BRG001 = qty 3." FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtScanStatus" Text="Siap scan..." FontSize="12" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- PILIH MEMBER (POIN PELANGGAN) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="BtnBatalMemberPos" DockPanel.Dock="Right" Content="X" Width="20" Height="20"
                                                    Style="{StaticResource SmallRedButton}" Visibility="Collapsed" Click="BtnBatalMemberPos_Click" ToolTip="Batalkan pilihan member"/>
                                            <TextBlock Text="👤 Pelanggan / Member (Opsional)" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                        </DockPanel>
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="TxtCariMemberPos" FontSize="12" Padding="6,4"
                                                     TextChanged="TxtCariMemberPos_TextChanged"
                                                     PreviewKeyDown="TxtCariMemberPos_PreviewKeyDown"
                                                     ToolTip="Ketik nama atau No. HP member untuk kumpulkan poin..."/>
                                            <!-- Popup autocomplete member -->
                                            <Popup x:Name="PupMemberPos" PlacementTarget="{Binding ElementName=TxtCariMemberPos}"
                                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                                   Width="{Binding ElementName=TxtCariMemberPos, Path=ActualWidth}">
                                                <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,2,0,0" SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                                                    </Border.Effect>
                                                    <ListBox x:Name="LstCariMemberPos" MaxHeight="160" BorderThickness="0"
                                                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             PreviewKeyDown="LstCariMemberPos_PreviewKeyDown"
                                                             PreviewMouseLeftButtonUp="LstCariMemberPos_Click">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="6,4"/>
                                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Nama}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                                                        <TextBlock Text="{Binding NoHp}" FontSize="10" Foreground="#64748B"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding PoinStr}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBlock x:Name="TxtMemberPoinInfo" Text="" FontSize="11" Foreground="#16A34A" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtTotal" Grid.Column="1" Text="Rp 0" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                </Grid>
                                <TextBlock Text="Metode Pembayaran" FontSize="12" Foreground="#64748B" Margin="0,6,0,4"/>
                                <ComboBox x:Name="CmbMetode" SelectionChanged="CmbMetode_SelectionChanged">
                                    <ComboBoxItem Content="Tunai" IsSelected="True"/>
                                    <ComboBoxItem Content="QRIS"/>
                                    <ComboBoxItem Content="GoPay"/>
                                    <ComboBoxItem Content="OVO"/>
                                    <ComboBoxItem Content="DANA"/>
                                    <ComboBoxItem Content="ShopeePay"/>
                                    <ComboBoxItem Content="Transfer Bank"/>
                                </ComboBox>
                                <TextBlock x:Name="TxtMetodeInfo" Text="" FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="Uang Bayar (Rp) - Enter = Bayar" FontSize="12" Foreground="#64748B" Margin="0,6,0,4"/>
                                <TextBox x:Name="TxtBayar" FontSize="16" FontWeight="Bold" TextChanged="TxtBayar_TextChanged" KeyDown="TxtBayar_KeyDown"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="10rb" Width="58" Margin="0,0,6,0" Style="{StaticResource GhostButton}" Padding="4" Click="BtnNominal_Click" Tag="10000"/>
                                    <Button Content="20rb" Width="58" Margin="0,0,6,0" Style="{StaticResource GhostButton}" Padding="4" Click="BtnNominal_Click" Tag="20000"/>
                                    <Button Content="50rb" Width="58" Margin="0,0,6,0" Style="{StaticResource GhostButton}" Padding="4" Click="BtnNominal_Click" Tag="50000"/>
                                    <Button Content="100rb" Width="58" Style="{StaticResource GhostButton}" Padding="4" Click="BtnNominal_Click" Tag="100000"/>
                                    <Button Content="Pas" Width="52" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="4" Click="BtnUangPas_Click"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kembalian" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtKembalian" Grid.Column="1" Text="Rp 0" FontSize="16" FontWeight="Bold" Foreground="#16A34A"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="F6 Reset" Margin="0,0,6,0" Style="{StaticResource GhostButton}" Click="BtnResetKeranjang_Click"/>
                                    <Button Grid.Column="1" Content="F5 BAYAR" Margin="6,0,0,0" Style="{StaticResource SuccessButton}" Click="BtnBayar_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Buka Laci" Margin="0,0,6,0" Style="{StaticResource GhostButton}" Click="BtnBukaLaciKasir_Click"/>
                                    <Button Grid.Column="1" Content="F8 Printer" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Click="BtnF8Printer_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== PAGE CEK BARANG (F2) - READ ONLY ===== -->
            <Grid x:Name="PageCek" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Cek Harga &amp; Stok Barang" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <Border Background="#DBEAFE" CornerRadius="6" Padding="8,4" Margin="12,0,0,0">
                                <TextBlock Text="Hanya lihat - kelola data di aplikasi Manager" FontSize="11" Foreground="#1E40AF"/>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="TxtCariCek" DockPanel.Dock="Top" Margin="0,0,0,10" TextChanged="TxtCariCek_TextChanged"/>
                        <DataGrid x:Name="DgCek" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="95"/>
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/>
                                <DataGridTextColumn Header="Nama Produk" Binding="{Binding Nama}" Width="*"/>
                                <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="70"/>
                                <DataGridTextColumn Header="Harga Jual" Binding="{Binding HargaJualRp}" Width="110"/>
                                <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="65"/>
                                <DataGridTextColumn Header="Kelompok" Binding="{Binding Kelompok}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== PAGE RIWAYAT SHIFT (F3) ===== -->
            <Grid x:Name="PageRiwayat" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Filter Metode:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbFilterMetodeRiwayat" Width="135" SelectionChanged="CmbFilterMetodeRiwayat_SelectionChanged">
                                    <ComboBoxItem Content="Semua Metode" IsSelected="True"/>
                                    <ComboBoxItem Content="💵 Hanya Tunai"/>
                                    <ComboBoxItem Content="📱 Hanya Non-Tunai"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Riwayat Transaksi Hari Ini" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox x:Name="TxtCariRiwayat" DockPanel.Dock="Top" Margin="0,0,0,10" TextChanged="TxtCariRiwayat_TextChanged"/>
                        <DataGrid x:Name="DgRiwayat" SelectionChanged="DgRiwayat_SelectionChanged" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                                <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalStr}" Width="130"/>
                                <DataGridTextColumn Header="Metode" Binding="{Binding MetodeBayar}" Width="90"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding JumlahItem}" Width="50"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtDetailJudul" Text="Detail Transaksi" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" x:Name="DgRiwayatDetail">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="45"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalRp}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" x:Name="TxtDetailTotal" Text="" FontWeight="Bold" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <Button Grid.Row="3" Content="F7 - Pratinjau / Cetak Struk" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="BtnCetakStruk_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== PAGE REKAP SHIFT & TUTUP KASIR (F4) ===== -->
            <Grid x:Name="PageRekap" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Filter Periode Rekap -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Periode Rekap:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpRekapDari" Width="140" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpRekapSampai" Width="140" Margin="0,0,8,0"/>
                                <Button Content="Terapkan" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="BtnTerapkanFilterRekap_Click" Margin="0,0,6,0"/>
                                <Button Content="Hari Ini" Style="{StaticResource GhostButton}" Padding="14,5" Click="BtnRekapHariIni_Click" Margin="0,0,6,0"/>
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12" Background="#DBEAFE" BorderBrush="#BFDBFE">
                                <StackPanel>
                                    <TextBlock Text="Total Omzet" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                    <TextBlock x:Name="CardOmzetShift" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#1E3A8A"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,6,12" Background="#DCFCE7" BorderBrush="#BBF7D0">
                                <StackPanel>
                                    <TextBlock Text="💵 Tunai" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                    <TextBlock x:Name="CardTunai" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#14532D"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0,6,12" Background="#F3E8FF" BorderBrush="#DDD6FE">
                                <StackPanel>
                                    <TextBlock Text="📱 Non-Tunai" FontSize="11" FontWeight="SemiBold" Foreground="#6B21A8"/>
                                    <TextBlock x:Name="CardNonTunai" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#581C87"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="3,0,6,12" Background="#FEF3C7" BorderBrush="#FDE68A">
                                <StackPanel>
                                    <TextBlock Text="💸 Uang Keluar" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                    <TextBlock x:Name="CardPengeluaranShift" Text="Rp 0" FontSize="17" FontWeight="ExtraBold" Foreground="#78350F"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="3,0,6,12" Background="#F0F9FF" BorderBrush="#BAE6FD">
                                <StackPanel>
                                    <TextBlock Text="Transaksi" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                                    <TextBlock x:Name="CardTrxShift" Text="0" FontSize="17" FontWeight="ExtraBold" Foreground="#0C4A6E"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource Card}" Margin="3,0,0,12" Background="#FFF1F2" BorderBrush="#FECDD3">
                                <StackPanel>
                                    <TextBlock Text="Item Terjual" FontSize="11" FontWeight="SemiBold" Foreground="#9F1239"/>
                                    <TextBlock x:Name="CardItemShift" Text="0" FontSize="17" FontWeight="ExtraBold" Foreground="#881337"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Panel Rekonsiliasi Tutup Shift (Sesuai Struk Laporan Kasir) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="📋 Rekonsiliasi Kas / Tutup Shift Kasir" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Modal Awal / Uang Masuk (Rp)" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtShiftModalAwal" Text="0" Padding="8,5" FontSize="13" FontWeight="Bold" TextChanged="TxtShiftDrawer_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Uang Fisik di Laci / Drawer (Rp)" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtShiftDrawerFisik" Text="0" Padding="8,5" FontSize="13" FontWeight="Bold" Background="#EFF6FF" BorderBrush="#3B82F6" TextChanged="TxtShiftDrawer_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Indikator Komputer vs Drawer -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Drawer (Fisik)" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtLabelDrawerFisik" Text="Rp 0" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Komputer (Sistem)" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtLabelKomputerTunai" Text="Rp 0" FontSize="15" FontWeight="Bold" Foreground="#2563EB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Selisih Kas" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtLabelSelisihKas" Text="Rp 0" FontSize="15" FontWeight="Bold" Foreground="#16A34A"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🖨️ Cetak Struk Laporan Kasir" Style="{StaticResource SuccessButton}" Margin="0,0,4,0" Padding="10,8" Click="BtnCetakStrukLaporanShift_Click" ToolTip="Cetak struk LAPORAN KASIR ke printer thermal / TM-U220 sesuai format fisik"/>
                                        <Button Grid.Column="1" Content="📄 Simpan PDF Rekap" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Padding="10,8" Click="BtnCetakRekap_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                <DockPanel>
                                    <TextBlock Text="Daftar Pengeluaran Kas (Uang Keluar)" FontWeight="Bold" FontSize="15" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                                    <DataGrid x:Name="DgPengeluaranKas" MaxHeight="190" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Waktu" Binding="{Binding TanggalStr}" Width="110"/>
                                            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="85"/>
                                            <DataGridTextColumn Header="Keperluan" Binding="{Binding Keterangan}" Width="*"/>
                                            <DataGridTextColumn Header="Nominal" Binding="{Binding NominalRp}" Width="95"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ringkasan Shift" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtRingkasanShift" Text="-" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0F172A" Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Kasir siap" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="   -   KasirKu POS v2.0" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="TxtInfoGlobal" Text="0 transaksi hari ini" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MODAL OVERLAY PENGATURAN PRINTER THERMAL (F8) -->
        <Grid x:Name="ModalPrinter" Visibility="Collapsed" Grid.RowSpan="4" Panel.ZIndex="999" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalPrinter_Click"/>
                        <TextBlock Text="Pengaturan Printer Thermal (Struk &amp; Kasir)" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Nama Printer Windows" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbModalPrinterName" IsEditable="True"/>
                        <Button Grid.Column="1" Content="Cek" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="12,6" Click="BtnModalRefreshPrinter_Click" ToolTip="Muat ulang daftar printer Windows"/>
                    </Grid>

                    <TextBlock Text="Lebar Kertas / Tipe Printer" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbModalLebarKertas" Margin="0,0,0,12">
                        <ComboBoxItem Content="80 mm (Standar Thermal 48 Kolom)" IsSelected="True"/>
                        <ComboBoxItem Content="76 mm (Dot Matrix / Epson TM-U220 40 Kolom)"/>
                        <ComboBoxItem Content="58 mm (Mini Thermal 32 Kolom)"/>
                    </ComboBox>

                    <CheckBox x:Name="ChkModalAutoCetakStruk" Content="Cetak struk otomatis setelah bayar" Margin="0,0,0,6" FontSize="13" IsChecked="True"/>
                    <CheckBox x:Name="ChkModalKickDrawer" Content="Buka laci kasir (Cash Drawer) otomatis" Margin="0,0,0,6" FontSize="13" IsChecked="True"/>
                    <CheckBox x:Name="ChkModalCetakSatuanStruk" Content="Tampilkan satuan produk di struk (mis: pcs, kg, pack)" Margin="0,0,0,16" FontSize="13" IsChecked="True"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Test Print" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnModalTestPrint_Click"/>
                        <Button Grid.Column="1" Content="Buka Laci" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BtnModalBukaLaci_Click"/>
                    </Grid>

                    <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Tutup" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnTutupModalPrinter_Click"/>
                        <Button Grid.Column="1" Content="Simpan Pengaturan" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnSimpanModalPrinter_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL INPUT CUSTOM HARGA (F9) -->
        <Grid x:Name="ModalCustomHarga" Visibility="Collapsed" Grid.RowSpan="4" Panel.ZIndex="1000" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="430" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalCustomHarga_Click"/>
                        <TextBlock Text="🏷️ Mode Custom Harga (F9)" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Masukkan nominal harga khusus yang diinginkan. Produk berikutnya yang dimasukkan ke keranjang akan bernilai harga ini (berlaku 1x)."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Nominal Harga Khusus (Rp)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtNominalCustomHarga" FontSize="20" FontWeight="Bold" Padding="12,8"
                             CaretBrush="#1D4ED8" Margin="0,0,0,16"
                             PreviewKeyDown="TxtNominalCustomHarga_PreviewKeyDown"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal (Esc)" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnTutupModalCustomHarga_Click"/>
                        <Button Grid.Column="1" Content="Aktifkan (Enter)" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnTerapkanCustomHarga_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL PENGELUARAN KAS / AMBIL UANG DRAWER -->
        <Grid x:Name="ModalPengeluaranKas" Visibility="Collapsed" Grid.RowSpan="4" Panel.ZIndex="1000" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalPengeluaranKas_Click"/>
                        <TextBlock Text="💸 Ambil Uang / Pengeluaran Kas" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Catat pengambilan uang dari laci/drawer (untuk setoran ke owner atau beli keperluan toko). Struk bukti pengeluaran kas akan otomatis dicetak."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Nominal Uang Diambil (Rp)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPengeluaranNominal" FontSize="18" FontWeight="Bold" Padding="10,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Kategori Pengeluaran" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPengeluaranKategori" Margin="0,0,0,12">
                        <ComboBoxItem Content="Setoran ke Owner" IsSelected="True"/>
                        <ComboBoxItem Content="Operasional Kasir"/>
                        <ComboBoxItem Content="Belanja Kebutuhan Toko"/>
                        <ComboBoxItem Content="Lain-lain"/>
                    </ComboBox>

                    <TextBlock Text="Keperluan / Keterangan" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPengeluaranKeterangan" Padding="10,6" Margin="0,0,0,18"
                             ToolTip="Contoh: Setoran shift 1 ke bos, Beli plastik kresek, Bayar galon air, dll."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Batal (Esc)" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="BtnTutupModalPengeluaranKas_Click"/>
                        <Button Grid.Column="1" Content="Simpan &amp; Cetak Bukti" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" Click="BtnSimpanPengeluaranKas_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL ANTREAN TERTAHAN (HOLD CART LIST) -->
        <Grid x:Name="ModalHoldCart" Visibility="Collapsed" Grid.RowSpan="4" Panel.ZIndex="1000" Background="#88000000">
            <Border Background="White" CornerRadius="16" Width="550" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="X" DockPanel.Dock="Right" Style="{StaticResource SmallRedButton}" Width="28" Height="28" Click="BtnTutupModalHoldCart_Click"/>
                        <TextBlock Text="📋 Antrean Keranjang Tertahan (Hold)" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Pilih antrean customer yang sudah selesai melihat-lihat untuk dimuat kembali ke keranjang kasir."
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,16">
                        <DataGrid x:Name="DgHoldCart" MaxHeight="240" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Jam" Binding="{Binding WaktuStr}" Width="75"/>
                                <DataGridTextColumn Header="Catatan Antrean" Binding="{Binding Catatan}" Width="*"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding TotalItem}" Width="50"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalHargaRp}" Width="110"/>
                                <DataGridTemplateColumn Header="Aksi" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="Muat (Recall)" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                                        Style="{StaticResource SmallBlueButton}"
                                                        Click="BtnRecallItemGrid_Click" Tag="{Binding}"/>
                                                <Button Content="Hapus" FontSize="11" Padding="6,2"
                                                        Style="{StaticResource SmallRedButton}"
                                                        Click="BtnHapusHoldGrid_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Button Grid.Row="3" Content="Tutup (Esc)" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="16,6" Click="BtnTutupModalHoldCart_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
