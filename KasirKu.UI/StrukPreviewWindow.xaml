<Window x:Class="KasirKu.UI.StrukPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pratinjau Struk" Height="840" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewButtonPrimary" TargetType="Button" BasedOn="{StaticResource PreviewButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="Pratinjau Struk" FontSize="22" FontWeight="ExtraBold" Foreground="White"/>
            <TextBlock x:Name="TxtInfo" FontSize="12" Foreground="#94A3B8"
                       TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Kertas thermal -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="12">
            <ScrollViewer x:Name="ScvPaper" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Border Background="White" CornerRadius="3" HorizontalAlignment="Center">
                    <Image x:Name="ImgStruk" Stretch="None" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- Tombol aksi -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnCetak" Content="Cetak Struk"
                    ToolTip="Kirim struk ke printer thermal"
                    Style="{StaticResource PreviewButtonPrimary}" Margin="0,0,6,0" Click="BtnCetak_Click"/>
            <Button Grid.Column="1" x:Name="BtnPng" Content="Simpan PNG"
                    ToolTip="Simpan gambar struk ke Documents/KasirKu/Struk"
                    Style="{StaticResource PreviewButton}" Margin="2,0,4,0" Click="BtnPng_Click"/>
            <Button Grid.Column="2" x:Name="BtnPdf" Content="Simpan PDF"
                    Style="{StaticResource PreviewButton}" Margin="4,0,4,0" Click="BtnPdf_Click"/>
            <Button Grid.Column="3" x:Name="BtnBukaPdf" Content="Buka PDF"
                    Style="{StaticResource PreviewButton}" Margin="4,0,2,0" Click="BtnBukaPdf_Click"/>
            <Button Grid.Column="4" x:Name="BtnTutup" Content="Tutup (Esc)"
                    Style="{StaticResource PreviewButton}" Margin="6,0,0,0" Click="BtnTutup_Click"/>
        </Grid>
    </Grid>
</Window>
